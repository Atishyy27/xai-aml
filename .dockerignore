# The image needs: backend/, models/, SynthDataGen/*.csv, requirements.txt, and
# the committed runtime artifacts. Everything else is a secret, a build output,
# or dead weight. Without this file, `COPY . /code/` shipped .env -- Neo4j Aura
# credentials -- into the image.

.env
.env.*
!.env.example

.git
.gitignore

# The frontend deploys to Vercel, not into this container.
frontend/

# The runtime artifacts (classifier, novelty.csv, metrics) ARE copied in; only
# the build-time-only autoencoder weights + scaler are excluded.
artifacts/autoencoder.pth
artifacts/scaler.pkl

# Superseded by models/ -- see README.md.
neo4j/
account_features.csv
gcn.pth
Docs/

**/__pycache__/
*.pyc
.venv/
venv/
.vscode/
.idea/
*.swp
